{
  // Cloudflare static assets for the demo. Build web/public/assets first (build_assets.sh).
  // Add a "routes" entry with your own domain if you want one.
  "name": "slyszeglosy-demo",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
